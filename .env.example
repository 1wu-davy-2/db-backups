# 元数据库（必填）
BACKUP_DATABASE_URL=postgres://dbb:secret@127.0.0.1:5432/dbbackups?sslmode=disable

# 主密钥：base64 的 32 字节。留空则自动生成到 $BACKUP_DATA_DIR/master.key
# 生成方式：openssl rand -base64 32
# 警告：丢失该密钥后，所有已加密的备份都无法解密。
BACKUP_MASTER_KEY=

# 监听地址与数据目录
BACKUP_HTTP_ADDR=:8080
BACKUP_DATA_DIR=./data
BACKUP_WEB_DIR=./web/dist

# 单实例最大并发备份数（每个 dump 都会消耗源库 IO，宁少勿多）
BACKUP_MAX_CONCURRENT=4

# 会话有效期（天）
BACKUP_SESSION_TTL_DAYS=7

# 走 HTTPS 时置为 1，Cookie 才会带 Secure 标记
BACKUP_COOKIE_SECURE=0

# 额外的 pg_dump 搜索目录（逗号分隔），用于非常规安装路径
BACKUP_PG_BIN_DIRS=
